{
  "name": "vid4u",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,cyan \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "vue-tsc -b && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b && tsc -p server/tsconfig.json --noEmit",
    "setup:tools": "node scripts/fetch-ytdlp.mjs",
    "update:ytdlp": "node scripts/fetch-ytdlp.mjs --latest",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "ffmpeg-static": "^5.3.0",
    "p-queue": "^10.0.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
