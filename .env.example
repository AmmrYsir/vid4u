# Copy to .env and adjust for your machine.
# Never commit the real .env or any cookies file.

PORT=8787
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Set HOST=0.0.0.0 and TRUST_PROXY=true when running behind a reverse proxy.
TRUST_PROXY=false

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Blank values are auto-detected: server/bin/yt-dlp(.exe) and ffmpeg-static.
YTDLP_PATH=
FFMPEG_PATH=

# Optional Netscape-format cookies. Use a burner account, local use only.
COOKIES_FILE=

# Optional proxy for geo-blocked/cloud-blocked platforms, e.g. http://127.0.0.1:8080
PROXY_URL=

# Comma-separated suffix allowlist. Add domains you want to support.
ALLOWED_HOSTS=facebook.com,fb.com,fb.watch,instagram.com,youtube.com,youtu.be,youtube-nocookie.com,tiktok.com,x.com,twitter.com,vimeo.com,reddit.com,redd.it,dailymotion.com,dai.ly,twitch.tv,pinterest.com,threads.net,linkedin.com

# Blank = server/.tmp. Use an absolute path on production hosts.
TEMP_DIR=

# Serve the built dist/ folder. Blank = auto-detect dist/index.html.
SERVE_STATIC=

MAX_DURATION_SECONDS=1800
MAX_FILESIZE_MB=500
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
JOB_TTL_MINUTES=30
RESOLVE_TIMEOUT_SECONDS=45
DOWNLOAD_TIMEOUT_SECONDS=600
RATE_LIMIT_RESOLVE_PER_MIN=10
RATE_LIMIT_JOBS_PER_MIN=5
